752. Check if Array Is Sorted and Rotated
class Solution {
    public boolean check(int[] nums) {
        int rotation=0;
        for(int i=1;i<nums.length;i++){
            if(nums[i-1]>nums[i]) rotation++;
        }
        if(nums[nums.length-1]>nums[0]) rotation++;    
        return rotation<=1;
    }
}

